use v5.26;
use strict;
use warnings;
use Test::More;
use FindBin;
use lib "$FindBin::Bin/../benchmark", "$FindBin::Bin/lib";
use ProjectTest qw(run_command);
use Profiles qw(profile_cases resolver_config);
use ResourceEvidence qw(parse_stats coverage clock_anomaly container_healthy check_heartbeat);
use JSON::PP qw(encode_json);
my %ids=(resolver=>'a'x64,client=>'b'x64);
my $row=sub {my ($role,$cpu,$mem)=@_; encode_json({ID=>substr($ids{$role},0,12),Name=>'private',CPUPerc=>$cpu,MemUsage=>$mem,NetIO=>'1B / 2B'});};
my $raw=$row->('resolver','5.2%','128MiB / 512MiB')."\n".$row->('client','1%','20MiB / 256MiB');
my ($samples,$errors)=parse_stats($raw,\%ids,30,1000);
is(scalar @$samples,2,'both roles parsed');
is_deeply($errors,[],'no parse errors');
ok(!exists $samples->[0]{Name},'container names not retained');
is($samples->[0]{elapsed},30,'source elapsed preserved');
is($samples->[0]{epoch},1000,'wall time preserved');
($samples,$errors)=parse_stats($row->('resolver','--','128MiB / 512MiB'),\%ids,30,1000);
is(scalar @$samples,0,'invalid stats excluded');
ok(@$errors,'invalid row diagnostic');
($samples,$errors)=parse_stats($raw."\n".$raw,\%ids,30,1000);
ok(@$errors,'duplicates reported');
my @samples=map {my $t=$_; map {{role=>$_,elapsed=>$t,MemUsage=>'128MiB / 512MiB'}} qw(resolver client)} (2,32,62,92,122,152,182,212,242,272,299);
my $c=coverage(\@samples,300,30);
ok($c->{complete},'full phase coverage');
is($c->{roles}{resolver}{last},299,'tail measured');
is($c->{roles}{resolver}{tail_memory_bytes},134217728,'late memory median');
$c=coverage([grep {$_->{elapsed}<180} @samples],300,30);
ok(!$c->{complete},'missing tail is a failure');
$c=coverage([grep {$_->{role} eq 'resolver'} @samples],300,30);
ok(!$c->{complete},'missing client is a failure');
$c=coverage([grep {$_->{elapsed}<60 || $_->{elapsed}>180} @samples],300,30);
ok(!$c->{complete},'internal gap is a failure');
ok(!coverage([],300,30)->{complete},'no samples fails');
ok(!clock_anomaly(30,31,45),'normal cadence');
ok(clock_anomaly(120,120,45),'long pause detected');
ok(clock_anomaly(30,120,45),'wall/monotonic discrepancy detected');
ok(clock_anomaly(30,-1,45),'backward wall clock detected');
my $inspect={RestartCount=>0,State=>{Running=>1,OOMKilled=>0,StartedAt=>'test'}};
ok(container_healthy($inspect,$inspect),'unchanged running container');
ok(!container_healthy($inspect,{%$inspect,RestartCount=>1}),'restart detected');
ok(!container_healthy($inspect,{%$inspect,State=>{%{$inspect->{State}},OOMKilled=>1}}),'OOM detected');
ok(!container_healthy($inspect,{%$inspect,State=>{%{$inspect->{State}},StartedAt=>'other'}}),'manual restart detected');
my @old=map {my $t=$_; map {{role=>$_,elapsed=>$t,MemUsage=>'128MiB / 512MiB'}} qw(resolver client)} map {2+32*$_} 0..68;
my $old=coverage(\@old,3600,30);
ok(!$old->{complete},'regression: last sample at roughly 36 min of 60 min');
cmp_ok($old->{roles}{resolver}{max_gap_seconds},'>',1300,'missing tail quantified');
my @check=profile_cases('soak-check');
is($check[0][6],120,'sampling smoke duration');
like(resolver_config("ip-ratelimit: 100\nratelimit: 200\n",'soak-check'),qr/ip-ratelimit: 0/,'sampling smoke private configuration');
ok(check_heartbeat({resolver=>30,client=>25},60,75),'fresh heartbeat accepted');
ok(!eval {check_heartbeat({resolver=>100,client=>10},100,75);1},'stale individual role aborts');
ok(!eval {check_heartbeat({},76,75);1},'absent heartbeat aborts');
my $watchdog_ok=eval {run_command([$^X,'-e','sleep 10'],'',15,sub {die "watchdog test failure\n"});1};
ok(!$watchdog_ok && $@ =~ /watchdog test failure/,'watchdog cancels command and propagates reason');
done_testing;
