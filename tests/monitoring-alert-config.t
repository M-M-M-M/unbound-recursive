use v5.26;
use strict;
use warnings;
use Test::More;
use FindBin;
use lib "$FindBin::Bin/lib";
use ProjectTest qw(read_bytes);
use JSON::PP qw(decode_json);
my $rule=decode_json(read_bytes("$FindBin::Bin/../monitoring/lab/provisioning/alerts-freshness.json"));
my $group=$rule->{groups}[0]; my $r=$group->{rules}[0];
is($group->{interval},'30s','30-second evaluation');
is($r->{for},'1m','pending period');
is($r->{noDataState},'Alerting','no data alerts');
is($r->{execErrState},'Alerting','query failure alerts');
is($r->{condition},'C','threshold is final condition');
is_deeply([map {$_->{refId}} @{$r->{data}}],[qw(A B C)],'query reduce threshold');
like($r->{data}[0]{model}{query},qr/host == "resolver-lab"/,'single known lab host');
like($r->{data}[0]{model}{query},qr/now\(\).*r\._time/,'source age, not ingestion age');
is($r->{data}[2]{model}{conditions}[0]{evaluator}{params}[0],120,'120-second threshold');
ok(!exists $rule->{contactPoints} && !exists $rule->{policies},'no automatic contact routing');
done_testing;
