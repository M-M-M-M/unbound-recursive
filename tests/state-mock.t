use v5.26;
use strict;
use warnings;
use Test::More;
use FindBin;
use lib "$FindBin::Bin/lib";
use ProjectTest qw(read_bytes write_bytes run_command confirm_command);
use File::Temp qw(tempdir);
use File::Copy qw(copy);
use Digest::SHA qw(sha512_hex);
use Cwd qw(getcwd abs_path);
my $root = "$FindBin::Bin/..";
my $script = "$root/scripts/state.sh";
my $cwd = getcwd();
my $dir = abs_path(tempdir(CLEANUP => 1));
END { chdir $cwd if defined $cwd; }
chdir $dir or die "chdir $dir: $!";
write_bytes('compose.yaml', '');
copy("$FindBin::Bin/lib/docker-mock.sh", 'docker') or die "copy mock: $!";
chmod 0755, 'docker' or die "chmod mock: $!";
write_bytes('anchor', "test anchor\n");
local %ENV = %ENV;
delete @ENV{qw(ABSENT STATUS BACKUP_SET)};
$ENV{PATH} = "$dir:$ENV{PATH}";
@ENV{qw(CALLS ANCHOR CREATED BACKUP_DIR STOPPED BIND_PATH)} = map { "$dir/$_" } qw(calls anchor created backups stopped bind-state);
mkdir $ENV{BIND_PATH}, 0750 or die "mkdir bind: $!";
sub state_op {
    my ($op, %env) = @_;
    local %ENV = (%ENV, %env);
    return run_command([$script, $op]);
}
sub interactive {
    my ($op, $word, %env) = @_;
    local %ENV = (%ENV, %env);
    return confirm_command($script, $op, $word);
}
my $r = state_op('backup', STATUS => 'running');
isnt($r->{code}, 0, 'running backup rejected');
like($r->{stderr}, qr/stop the resolver/, 'running backup diagnostic');
$r = state_op('backup');
is($r->{code}, 0, 'stopped backup succeeds') or BAIL_OUT($r->{stderr});
my @sets = glob "$dir/backups/dnssec-*";
is(scalar @sets, 1, 'one backup set') or BAIL_OUT('missing backup');
my $backup = $sets[0];
is(read_bytes("$backup/root.key"), read_bytes('anchor'), 'backup bytes');
is(read_bytes("$backup/root.key.sha512"), sha512_hex(read_bytes('anchor')) . "\n", 'backup SHA-512');
$r = state_op('purge');
isnt($r->{code}, 0, 'noninteractive purge rejected');
like($r->{stderr}, qr/interactive terminal/, 'purge diagnostic');
unlike(read_bytes('calls'), qr/down --volumes/, 'no destructive command');
$r = state_op('restore', BACKUP_SET => $backup);
isnt($r->{code}, 0, 'noninteractive restore rejected');
like($r->{stderr}, qr/interactive terminal/, 'restore diagnostic');
write_bytes("$backup/root.key", 'corrupt');
$r = state_op('restore', BACKUP_SET => $backup);
isnt($r->{code}, 0, 'corrupt restore rejected');
like($r->{stderr}, qr/checksum mismatch/, 'checksum diagnostic');
write_bytes("$backup/root.key", "test anchor\n");
write_bytes('anchor', "other state\n");
is(interactive('restore', 'RESTORE', BACKUP_SET => $backup)->{code}, 0, 'confirmed restore');
is(read_bytes('anchor'), "test anchor\n", 'restored bytes');
isnt(state_op('restore', BACKUP_SET => $backup, ABSENT => 1)->{code}, 0, 'absent noninteractive refused');
ok(!-e 'created', 'no creation');
write_bytes("$backup/root.key", 'corrupt');
isnt(state_op('restore', BACKUP_SET => $backup, ABSENT => 1)->{code}, 0, 'absent corrupt refused');
ok(!-e 'created', 'no creation after corruption');
write_bytes("$backup/root.key", "test anchor\n");
isnt(interactive('restore', 'NO', BACKUP_SET => $backup, ABSENT => 1)->{code}, 0, 'restore cancelled');
ok(!-e 'created', 'no creation after cancellation');
is(interactive('restore', 'RESTORE', BACKUP_SET => $backup, ABSENT => 1)->{code}, 0, 'restore absent container');
ok(-e 'created', 'stopped container created');
is(read_bytes('anchor'), "test anchor\n", 'recovered bytes');
isnt(interactive('purge', 'NO')->{code}, 0, 'purge cancelled');
unlike(read_bytes('calls'), qr/down --volumes/, 'cancel did not purge');
is(interactive('purge', 'PURGE')->{code}, 0, 'confirmed purge');
like(read_bytes('calls'), qr/down --volumes/, 'purge issued');
ok(!-e '.state-ops.lock', 'lock released');
# Bind mounts are backed up/restored through the same constrained helper.
write_bytes('calls', '');
is(state_op('backup', BIND => 1)->{code}, 0, 'bind backup succeeds');
like(read_bytes('calls'), qr/type=bind,source=\Q$ENV{BIND_PATH}\E,target=\/state,readonly/, 'bind helper read-only source');
write_bytes('anchor', "changed\n");
is(interactive('restore', 'RESTORE', BACKUP_SET => $backup, BIND => 1)->{code}, 0, 'bind restore succeeds');
is(read_bytes('anchor'), "test anchor\n", 'bind bytes restored');
write_bytes('calls', '');
isnt(state_op('backup', BIND => 1, ACTUAL_BIND => '/different/path')->{code}, 0, 'mismatched bind rejected');
unlike(read_bytes('calls'), qr/run --rm/, 'mismatch does not mount helper');
write_bytes('calls', '');
write_bytes("$ENV{BIND_PATH}/sentinel", 'keep');
isnt(interactive('purge', 'NO', BIND => 1)->{code}, 0, 'bind purge cancelled');
ok(-f 'anchor', 'cancel preserves bind anchor');
unlike(read_bytes('calls'), qr/run --rm|compose -f compose.yaml stop/, 'cancel neither stops nor mounts helper');
write_bytes('calls', '');
is(interactive('purge', 'PURGE', BIND => 1, STATUS => 'running')->{code}, 0, 'confirmed bind purge stops service');
ok(!-e 'anchor', 'bind anchor removed');
ok(-d $ENV{BIND_PATH}, 'bind directory retained');
is(read_bytes("$ENV{BIND_PATH}/sentinel"), 'keep', 'unrelated file retained');
is(read_bytes("$backup/root.key"), "test anchor\n", 'backup retained');
like(read_bytes('calls'), qr/stop unbound.*run --rm.*down/s, 'stop before deletion before down');
unlike(read_bytes('calls'), qr/down --volumes/, 'bind purge preserves volumes');
like(read_bytes('calls'), qr/compose -f compose.yaml down/, 'bind purge removes container');
write_bytes('calls', '');
isnt(state_op('purge', BIND => 1, ACTUAL_BIND => '/different/path')->{code}, 0, 'purge refuses mismatched state mount');
unlike(read_bytes('calls'), qr/compose -f compose.yaml down/, 'mismatch cannot purge');
write_bytes('anchor', "test anchor\n");
write_bytes('calls', '');
isnt(interactive('purge', 'PURGE', BIND => 1, BUSY => 1)->{code}, 0, 'shared running mount refused');
ok(-f 'anchor', 'busy mount preserved');
unlike(read_bytes('calls'), qr/run --rm/, 'busy mount not mounted by helper');
write_bytes('calls', '');
isnt(interactive('purge', 'PURGE', BIND => 1, PURGE_FAIL => 1)->{code}, 0, 'helper error propagates');
ok(-f 'anchor', 'failed helper did not delete anchor');
unlike(read_bytes('calls'), qr/compose -f compose.yaml down/, 'no down after failed deletion');
unlink 'created';
write_bytes('calls', '');
is(interactive('purge', 'PURGE', BIND => 1, ABSENT => 1)->{code}, 0, 'purge after clean with existing bind anchor');
like(read_bytes('calls'), qr/create --no-build --pull never unbound/, 'creates stopped helper source');
ok(!-e 'anchor', 'anchor removed after clean');
unlike(read_bytes('calls'), qr/compose -f compose.yaml (?:up|start)/, 'purge never starts resolver');
local $ENV{BIND_PATH} = "$dir/missing";
isnt(state_op('check', BIND => 1)->{code}, 0, 'missing bind directory refused by preflight');
like(state_op('check', BIND => 1)->{stderr}, qr/pre-create/, 'missing bind directory diagnostic');
is(state_op('check')->{code}, 0, 'named volume preflight succeeds');
done_testing;
