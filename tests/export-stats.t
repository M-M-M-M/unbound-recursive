use v5.26;
use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use FindBin;
use lib "$FindBin::Bin/lib";
use ProjectTest qw(run_command read_bytes);
my $dir=tempdir(CLEANUP=>1);
my $file="$dir/stats.lp";
my $script="$FindBin::Bin/../monitoring/export-stats.pl";
my $valid="total.num.queries=123\ntotal.num.cachehits=100\ntotal.num.cachemiss=23\ntotal.recursion.time.avg=0.1\nnum.answer.rcode.SERVFAIL=2\nclient.192.0.2.1=99\n";
sub run { run_command([$^X,$script,$file],$_[0],10) }
is(run($valid)->{code},0,'valid stats exported');
my $before=read_bytes($file);
like($before,qr/^unbound_snapshot,service=unbound-recursive /,'separate measurement');
like($before,qr/total_num_queries=123/,'normalized key');
like($before,qr/total_recursion_time_avg=0\.1/,'decimal field');
like($before,qr/ [0-9]{10}000000000\n\z/,'explicit collection timestamp');
unlike($before,qr/client|192\.0\.2\.1/,'no per-client data');
is((stat($file))[2]&0777,0640,'restricted output permissions');
isnt(run('')->{code},0,'empty input refused');
isnt(run($valid."total.num.queries=1\n")->{code},0,'duplicate refused');
isnt(run($valid=~s/queries=123/queries=invalid/r)->{code},0,'malformed number refused');
is(read_bytes($file),$before,'failure preserves prior timestamp and contents');
unlink $file or die $!;
symlink "$dir/other",$file or die $!;
isnt(run($valid)->{code},0,'symlink refused');
done_testing;
