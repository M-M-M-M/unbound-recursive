          "query": "from(bucket: \"resolver-lab\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"unbound_benchmark_phase\" and (r._field == \"requested\" or r._field == \"sent\" or r._field == \"successes\" or r._field == \"failed\" or r._field == \"not_attempted\" or r._field == \"ip_limited\"))",
          "datasource": {
            "type": "influxdb",
            "uid": "resolver-lab-flux"
